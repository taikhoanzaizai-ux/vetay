{
  "manifest_version": 3,
  "name": "Vẽ Tay · Google Flow",
  "version": "1.0.0",
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "worker.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:7877/*",
    "https://*.googleusercontent.com/*",
    "https://flow.google.com/*",
    "https://labs.google/*"
  ]
}